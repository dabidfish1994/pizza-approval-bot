# ─── Identity ────────────────────────────────────────────────────────────────
# Domino's requires a name and email on the order. Not secrets.
CUSTOMER_FIRST_NAME=Your
CUSTOMER_LAST_NAME=Name
CUSTOMER_EMAIL=you@example.com

# ─── 1Password secret references ─────────────────────────────────────────────
# Values live in 1Password; only references live here.
# Verify each one with:  op read "op://Personal/Home Address/address1"
OP_ADDRESS1_REF=op://Personal/Home Address/address1
OP_CITY_REF=op://Personal/Home Address/city
OP_STATE_REF=op://Personal/Home Address/state
OP_ZIP_REF=op://Personal/Home Address/zip
OP_PHONE_REF=op://Personal/Home Address/phone

OP_CARD_NUMBER_REF=op://Personal/Pizza Card/number
OP_CARD_EXP_MONTH_REF=op://Personal/Pizza Card/exp_month
OP_CARD_EXP_YEAR_REF=op://Personal/Pizza Card/exp_year
OP_CARD_CVV_REF=op://Personal/Pizza Card/cvv
OP_CARD_NAME_REF=op://Personal/Pizza Card/cardholder
# Optional. Defaults to OP_ZIP_REF, which is right unless your card bills elsewhere.
#OP_CARD_BILLING_ZIP_REF=op://Personal/Pizza Card/billing_zip

# ─── Ordering ────────────────────────────────────────────────────────────────
SERVICE_METHOD=Delivery

# Tip starts at 0 deliberately. The Domino's API sends `Amount` and `TipAmount`
# as separate fields and its docs do not state whether Amount is tip-inclusive.
# We send Amount = food+fees+tax+tip, which is correct under either reading
# EXCEPT if Domino's adds TipAmount on top — which would double the tip.
# Place ONE real order at 0, check the exact charge on your statement, then
# raise this. The MAX_ORDER_TOTAL_USD cap bounds the damage regardless.
DEFAULT_TIP_PERCENT=0

# ─── Hard limits (the actual security boundary) ──────────────────────────────
# Approval is LLM-mediated, so these gates — not the chat prompt — are what
# stops a confused or prompt-injected agent. Start strict.
MAX_ORDER_TOTAL_USD=75
MAX_ORDERS_PER_DAY=1
ORDER_COOLDOWN_MINUTES=30
APPROVAL_TTL_SECONDS=600
MAX_ITEMS_PER_ORDER=6

# Optional allowlist of Domino's store IDs. Once you know your local store,
# set it — it stops any possibility of ordering to the wrong place.
# Find it with: npm run pizza -- stores
#ALLOWED_STORE_IDS=8278

# ─── Safety ──────────────────────────────────────────────────────────────────
# true  = `confirm` runs every check and stops short of charging
# false = `confirm` charges the card for real
DRY_RUN=true

# Where pending orders, history, and the placement lock are stored.
#PIZZA_STATE_DIR=/Users/you/.pizza-bot
